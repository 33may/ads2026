---
config:
  theme: base
  themeVariables: { fontFamily: Helvetica, fontSize: 14px, edgeLabelBackground: '#ffffff' }
  flowchart: { curve: basis, nodeSpacing: 50, rankSpacing: 80 }
---
flowchart LR
  client@{ icon: "lucide:user", form: "rounded", label: "Client · end user", pos: "b", h: 56 }
  dev@{ icon: "lucide:terminal", form: "rounded", label: "Developer client", pos: "b", h: 56 }
  subgraph server["<b>Logical server</b> (hostname:port)"]
    direction LR
    wc["<b>Word-count service</b><br/>RPyC · counts keywords<br/><i>Client API · Developer API</i>"]
    redis[("<b>Cache</b><br/>Redis · results, hot keywords")]
    fs[("<b>File store</b><br/>S3-like · texts")]
    wc <-->|"C2 · Redis protocol"| redis
    wc <-->|"C3 · HTTP"| fs
  end
  client <-.->|"C1 · RPyC (RPC)"| wc
  dev <-.->|"C4 · RPyC (RPC)"| wc
  classDef svc fill:#D6E8F7,stroke:#4F86B8,rx:8,ry:8
  classDef store fill:#E4EFDB,stroke:#6E9F4A
  class wc svc
  class redis,fs store
  style server fill:#F7F5F1,stroke:#B0B0B0,rx:12,ry:12
  style client fill:#F3F0EB,stroke:#9A9A9A
  style dev fill:#F3F0EB,stroke:#9A9A9A
